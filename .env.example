# Environment Variables สำหรับระบบการแจ้งเตือนอีเมล
# สำหรับ Gmail SMTP
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-specific-password

# อีเมลแอดมิน (สำหรับรับการแจ้งเตือน)
ADMIN_EMAIL_1=admin@hotel.com
ADMIN_EMAIL_2=manager@hotel.com

# สำหรับฐานข้อมูล (ถ้ายังไม่มี)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=hotel_booking_system

# สำหรับ JWT (ถ้ายังไม่มี)
JWT_SECRET=your-secret-key