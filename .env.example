# =============================================================
# Hotel Booking System — Environment Variables
# =============================================================
# Copy this file and fill in real values:
#   cp .env.example backend/.env          ← Bun/Elysia backend
#   cp .env.example frontend/.env.local   ← Next.js frontend
#
# Each service reads variables relevant to itself only.
# =============================================================

# ----------------------------
# BACKEND (backend/.env)
# ----------------------------

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL — Neon or local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# CORS — set to the frontend origin
CORS_ORIGIN=http://localhost:3680

# Email (Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Hotel Booking System

# Admin notification emails
ADMIN_EMAIL_1=admin@hotel.com
ADMIN_EMAILS=admin@hotel.com

# ----------------------------
# FRONTEND (frontend/.env.local)
# ----------------------------

# Backend API URL — must match backend PORT above
NEXT_PUBLIC_API_URL=http://localhost:3001

# Site URL (used in email links etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3680
