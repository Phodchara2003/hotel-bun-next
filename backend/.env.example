# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:npg_N6QVxYpgu5EG@ep-rough-dream-a1b92i89-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Gmail Configuration สำหรับระบบส่งอีเมลอัตโนมัติ
# 📧 GMAIL_USER: อีเมล Gmail ที่จะเป็นผู้ส่งของระบบ
# ตัวอย่าง: hotel.booking.system@gmail.com, noreply.hotelapp@gmail.com
GMAIL_USER=your-email@gmail.com

# 🔐 GMAIL_APP_PASSWORD: App Password จาก Google (16 ตัวอักษร)
# ⚠️ ไม่ใช่รหัsผ่านปกติ! ต้องสร้างใน Google Account Settings
# วิธีสร้าง App Password:
# 1. ไป https://myaccount.google.com
# 2. Security → 2-Step Verification (เปิดให้เรียบร้อยก่อน)
# 3. Security → App passwords
# 4. Select app: Mail, Select device: Other (Custom name)
# 5. ตั้งชื่อ: "Hotel Booking System"
# 6. คัดลอกรหัส 16 ตัว (รูปแบบ: xxxx xxxx xxxx xxxx)
GMAIL_APP_PASSWORD=your-app-password

# Email Settings
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Hotel Booking System
